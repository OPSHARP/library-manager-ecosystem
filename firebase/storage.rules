rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmailAuth() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Max file size: 5 MB
    function isValidFileSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // ─── Library logos & banners ───
    // The app only stores library branding under library_images/{ownerUid}.
    // Writes are restricted to the owning account (no cross-tenant
    // overwrites); reads require authentication. No PII buckets exist.
    match /library_images/{uid}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isEmailAuth()
                   && request.auth.uid == uid
                   && isImage()
                   && isValidFileSize();
    }

    // Default: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
