rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    //  SECURITY HELPERS
    // ═══════════════════════════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmailAuth() {
      return isAuthenticated()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return isEmailAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isEmailAuth()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // True when the caller is a student whose DEVICE is bound (authUid) to a
    // student record under THIS owner. Binding is performed server-side by the
    // `verifyStudentId` Cloud Function — it can never be forged by editing the
    // student's own profile. This is the ONLY way a student may access an
    // owner's private records, which prevents cross-tenant PII disclosure.
    function isRegisteredStudent(ownerId) {
      let studentId = get(/databases/$(database)/documents/student_profiles/$(request.auth.uid)).data.studentUniqueId;
      return isAuthenticated()
        && studentId is string
        && get(/databases/$(database)/documents/users/$(ownerId)/students/$(studentId)).data.authUid == request.auth.uid;
    }

    // True when the caller is a student who has JOINED this owner's library
    // (currentOwnerUid is set SERVER-SIDE by the joinLibrary Cloud Function —
    // clients can never write it, see the student_profiles rules below). This
    // gates the "public catalog" (libraries/seats/books) to the student's own
    // joined library instead of the whole world, preventing cross-tenant
    // enumeration of seat assignments / student names.
    function isStudentOf(ownerId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/student_profiles/$(request.auth.uid)).data.currentOwnerUid == ownerId;
    }

    function ticketOwner(ticketId) {
      return get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId;
    }

    // Coordinates are OPTIONAL — when the key is absent or explicitly null
    // (the library-setup flow writes null when GPS is unavailable) the write
    // is allowed. When a coordinate IS provided it must be a number within a
    // valid range, which prevents junk / out-of-range data being injected
    // into the public "nearby libraries" map.
    function validCoordinate(value, min, max) {
      return value == null
        || ((value is int || value is float) && value >= min && value <= max);
    }

    function validCoordinates(data) {
      return validCoordinate('latitude' in data ? data.latitude : null, -90, 90)
        && validCoordinate('longitude' in data ? data.longitude : null, -180, 180);
    }

    // ═══════════════════════════════════════════════════════════════
    //  LIBRARY REGISTRY — Student lookup by code
    // ═══════════════════════════════════════════════════════════════

    match /library_registry/{code} {
      // Readable by ANY authenticated user (including anonymous-auth students
      // of the student portal). The registry only holds PUBLIC library info
      // (ownerUid/libraryId/libraryName/contact) — the same data the library
      // QR code encodes and that is already readable under users/{owner}/
      // libraries. Anonymous students must be able to look up a library by
      // code to join it.
      allow read: if isAuthenticated();

      // Only an email-auth owner may register an entry, and only under their
      // own uid. `!resource.exists` is intentionally omitted: a legitimate
      // owner's first save is a create and later saves update the same doc —
      // both must succeed without being blocked by doc-state checks.
      allow create: if isEmailAuth()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.libraryId is string
        && request.resource.data.libraryName is string
        && validCoordinates(request.resource.data);

      // The owner who created the entry may update it. Only their own entry.
      allow update: if isEmailAuth()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.libraryId is string
        && request.resource.data.libraryName is string
        && validCoordinates(request.resource.data);

      // The owner may remove their own entry (account/code cleanup).
      allow delete: if isEmailAuth() && resource.data.ownerUid == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════
    //  REGISTERED LIBRARIES — Public catalog for the nearby-libraries map
    // ═══════════════════════════════════════════════════════════════

    match /registered_libraries/{libraryId} {
      // Public library info (name/address/contact/coordinates) readable by any
      // authenticated student so the portal can show libraries on the map.
      allow read: if isAuthenticated();

      // The owning email-auth user registers/updates/deletes their own entry.
      allow create: if isEmailAuth()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.libraryId is string
        && request.resource.data.libraryName is string
        && validCoordinates(request.resource.data);
      allow update: if isEmailAuth()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && validCoordinates(request.resource.data);
      allow delete: if isEmailAuth() && resource.data.ownerUid == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════
    //  USER PROFILES & ALL SUBCOLLECTIONS
    // ═══════════════════════════════════════════════════════════════

    match /users/{userId} {

      // ─── Profile document ───
      allow read: if isOwner(userId);
      // Only the fields the app actually writes may be present on create,
      // and isAdmin / role can NEVER be set by a client (server-only).
      // This closes the self-service admin-escalation path where a raw
      // Firestore create of users/{own-uid} with `isAdmin: true` forged the
      // isAdmin() gate and granted cross-tenant read/write of every
      // support_tickets document.
      allow create: if isOwner(userId) && !resource.exists
        && request.resource.data.keys().hasOnly(
             ['uid', 'displayName', 'email', 'role', 'isAdmin',
              'createdAt', 'updatedAt'])
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('role', '') != 'admin';
      // isAdmin / role are NOT client-writable — set only by the server.
      // Uses a diff so PARTIAL updates (e.g. displayName only) are allowed,
      // but only ever on the whitelisted fields.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['uid', 'displayName', 'email', 'createdAt', 'updatedAt']);
      allow delete: if false;

      // ─── All subcollections ───
      match /{subcollection}/{docId} {

        // === OWNER (email auth) FULL ACCESS ===
        // 'subscription' is deliberately excluded (server-only, below).
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && subcollection != 'subscription'
          && request.resource.data.createdAt is timestamp;
        allow update: if isOwner(userId) && subcollection != 'subscription';
        allow delete: if isOwner(userId) && subcollection != 'subscription';

        // Public catalog — the student portal browses these after joining the
        // library (owner or that owner's joined students only). Restricted to
        // the student's OWN joined library so seat assignments / student
        // names and library details are not enumerable cross-tenant.
        allow read: if (isOwner(userId) || isStudentOf(userId))
          && subcollection in ['libraries', 'seats', 'books', 'notices'];

        // Public library info — any authenticated student may read a library
        // document (name/address/contact/capacity/working hours) of any
        // registered library so the portal can show nearby libraries. Seat
        // and student records are NOT included here.
        allow read: if isAuthenticated() && subcollection == 'libraries';

        // Private records — only the owner, or a REGISTERED student of THIS
        // owner (device-bound), may read. Prevents cross-tenant PII leaks.
        allow read: if (isOwner(userId) || isRegisteredStudent(userId))
          && subcollection in ['attendance', 'fees', 'book_transactions'];

        // Students may read ONLY their own record (authUid-bound); they can
        // never list or fetch other students by guessing IDs.
        allow get: if isOwner(userId)
          || (isAuthenticated()
            && get(/databases/$(database)/documents/users/$(userId)/students/$(docId)).data.authUid == request.auth.uid);

        // A bound student may update only their own FCM tokens. The authUid
        // binding is set server-side by `verifyStudentId` — no client may set
        // it, which removes the "claim a null authUid" takeover race.
        allow update: if isAuthenticated()
          && subcollection == 'students'
          && resource.data.authUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']);

        // ─── Student notification sub-subcollections ───
        match /notifications/{notificationId} {
          allow read: if isOwner(userId)
            || (isAuthenticated()
              && get(/databases/$(database)/documents/users/$(userId)/students/$(docId)).data.authUid == request.auth.uid);
          allow update: if isAuthenticated()
            && subcollection == 'students'
            && get(/databases/$(database)/documents/users/$(userId)/students/$(docId)).data.authUid == request.auth.uid
            && request.resource.data.keys().hasOnly(['isRead'])
            && request.resource.data.isRead == true;
          allow create, delete: if false;
        }

        // ─── Subscription — write is SERVER-ONLY (Cloud Function verifies
        // the Google Play purchase). Clients may read their own status but can
        // never forge an active subscription. ───
        match /subscription/{subscriptionId} {
          allow read: if isOwner(userId);
          allow create, update, delete: if false;
        }
      }
    }

    // ═══════════════════════════════════════════════════════════════
    //  WHITE-LABEL REQUESTS
    // ═══════════════════════════════════════════════════════════════

    match /white_label_requests/{requestId} {
      allow create: if isEmailAuth()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId is string;
      allow read: if isEmailAuth()
        && resource.data.ownerId == request.auth.uid;
      allow update: if isEmailAuth()
        && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    //  SUPPORT TICKETS
    // ═══════════════════════════════════════════════════════════════

    match /support_tickets/{ticketId} {
      allow create: if isEmailAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(
             ['ticketId', 'userId', 'userName', 'userEmail',
              'subject', 'status', 'createdAt', 'lastMessageAt', 'lastMessage']);
      allow read: if isEmailAuth()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isEmailAuth()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if false;

      match /messages/{messageId} {
        // Messages visible/appendable only by the ticket owner or an admin.
        allow read: if isEmailAuth()
          && (ticketOwner(ticketId) == request.auth.uid || isAdmin());
        allow create: if isEmailAuth()
          && (ticketOwner(ticketId) == request.auth.uid || isAdmin())
          && request.resource.data.senderId == request.auth.uid
          // isAdmin must match the caller's REAL admin status (no forging).
          && request.resource.data.isAdmin == isAdmin()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.keys().hasOnly(
               ['senderId', 'senderName', 'senderEmail', 'text', 'timestamp', 'isAdmin']);
        allow update, delete: if false;
      }
    }

    // ═══════════════════════════════════════════════════════════════
    //  STUDENT PROFILES — Owned by students, written SERVER-SIDE ONLY
    // ═══════════════════════════════════════════════════════════════

    match /student_profiles/{profileId} {
      // A student may always read their own profile doc.
      allow read: if request.auth != null && request.auth.uid == profileId;

      // All profile WRITES are server-only: createStudentProfile and
      // updateStudentProfile Cloud Functions write via the Admin SDK (they
      // generate the unique ID, validate identity fields and set the library
      // linkage server-side). A client can never create, forge, or rewrite
      // its profile — including currentOwnerUid / verifiedOwnerUid /
      // studentUniqueId — by writing directly to Firestore, which closes the
      // "claim an arbitrary library" and PII-injection attack paths.
      allow create, update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    //  FALLBACK — Deny everything else
    // ═══════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
